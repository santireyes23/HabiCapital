# Copia este archivo a .env (ignorado por git) y ajusta los valores.
#
# Los valores de abajo son FICTICIOS, solo para desarrollo local. No son credenciales reales:
# no los uses en ningún entorno compartido ni en producción.

# URL de la BD principal (obligatoria: la app no arranca sin ella).
# Si la contraseña tiene caracteres especiales (@ : / ? # % &), codifícalos para URL.
HABICAPITAL_DATABASE_URL=postgresql+psycopg://habicapital:habicapital@localhost:5432/habicapital

# URL de la BD de pruebas (la usa solo pytest). Debe terminar en _test: la suite vacía sus
# tablas entre pruebas y se niega a correr contra cualquier otra base.
HABICAPITAL_TEST_DATABASE_URL=postgresql+psycopg://habicapital:habicapital@localhost:5432/habicapital_test

# Solo para docker compose (no se usan con PostgreSQL instalado en el sistema).
POSTGRES_USER=habicapital
POSTGRES_PASSWORD=habicapital
POSTGRES_DB=habicapital
POSTGRES_PORT=5432
